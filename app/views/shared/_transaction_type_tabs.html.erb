<%# locals: (active_tab:, account_id: nil, quick: false) %>

<% expense_path = quick ? quick_new_transaction_path(nature: "outflow", account_id: account_id) : new_transaction_path(nature: "outflow", account_id: account_id) %>
<% income_path = quick ? quick_new_transaction_path(nature: "inflow", account_id: account_id) : new_transaction_path(nature: "inflow", account_id: account_id) %>
<% transfer_path = quick ? quick_new_transaction_path(nature: "transfer", from_account_id: account_id) : new_transfer_path(from_account_id: account_id) %>

<%= render DS::SegmentedControl.new(full_width: true, aria_label: t("shared.transaction_tabs.aria", default: "Transaction type")) do |sc| %>
  <% sc.with_segment(
       safe_join([ icon("minus-circle"), tag.span(t("shared.transaction_tabs.expense"), class: "truncate") ]),
       active: active_tab == "expense",
       href: expense_path,
       class: "min-w-0 gap-2",
       data: quick ? { turbo_frame: "quick-new-form", action: "click->transaction-type-tabs#selectTab", nature: "outflow", "transaction-type-tabs-target": "tab" } : { turbo_frame: :modal, action: "click->transaction-type-tabs#selectTab", nature: "outflow", "transaction-type-tabs-target": "tab" }) %>

  <% sc.with_segment(
       safe_join([ icon("plus-circle"), tag.span(t("shared.transaction_tabs.income"), class: "truncate") ]),
       active: active_tab == "income",
       href: income_path,
       class: "min-w-0 gap-2",
       data: quick ? { turbo_frame: "quick-new-form", action: "click->transaction-type-tabs#selectTab", nature: "inflow", "transaction-type-tabs-target": "tab" } : { turbo_frame: :modal, action: "click->transaction-type-tabs#selectTab", nature: "inflow", "transaction-type-tabs-target": "tab" }) %>

  <% sc.with_segment(
       safe_join([ icon("arrow-right-left"), tag.span(t("shared.transaction_tabs.transfer"), class: "truncate") ]),
       active: active_tab == "transfer",
       href: transfer_path,
       class: "min-w-0 gap-2",
       data: quick ? { turbo_frame: "quick-new-form" } : { turbo_frame: :modal }) %>
<% end %>
