<% account = @entry&.account %>
<% enabled_by_default = params.dig(:entry, :cashback_enabled).nil? && account&.cashback_setting&.enabled? %>
<section class="<%= "hidden" if @quick_nature == "inflow" %>" data-transaction-form-target="cashbackSection">
  <div class="flex items-center justify-between">
    <%= label_tag "entry_cashback_enabled", t("transactions.form.cashback_label"), class: "text-sm text-secondary" %>
    <%= render DS::Toggle.new(id: "entry_cashback_enabled", name: "entry[cashback_enabled]", checked: params.dig(:entry, :cashback_enabled) == "1" || enabled_by_default, data: { transaction_form_target: "cashbackToggle", action: "change->transaction-form#toggleCashback" }) %>
  </div>
</section>
