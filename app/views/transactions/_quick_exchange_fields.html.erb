<%# locals: (form:, transferring:) %>
<% controller = transferring ? "transfer-form" : "transaction-form" %>
<% convert_input = capture do %>
  <% if transferring %>
    <%= form.number_field :exchange_rate, label: t("shared.exchange_rate_tabs.exchange_rate"), min: "0.00000000000001", step: "any", data: { transfer_form_target: "exchangeRateField", action: "input->transfer-form#onConvertExchangeRateChange" } %>
  <% else %>
    <%= form.fields_for :entryable do |ef| %>
      <%= ef.number_field :exchange_rate, label: t("shared.exchange_rate_tabs.exchange_rate"), min: "0.00000000000001", step: "any", data: { transaction_form_target: "exchangeRateField", action: "input->transaction-form#onConvertExchangeRateChange" } %>
    <% end %>
  <% end %>
<% end %>
<% destination_input = capture do %>
  <%= number_field_tag :destination_amount, nil, id: "quick_destination_amount", autocomplete: "off", min: "0", step: "any", class: "form-field__input", data: { "#{controller}_target": "destinationAmount", action: "input->#{controller}#onCalculateRateDestinationAmountChange" } %>
<% end %>
<%= render "shared/exchange_rate_tabs", controller_id: controller, controller_key: controller.tr("-", "_"),
      help_text: t("shared.exchange_rate_tabs.exchange_rate_help"),
      convert_tab_label: t("shared.exchange_rate_tabs.convert_tab"),
      calculate_rate_tab_label: t("shared.exchange_rate_tabs.calculate_rate_tab"),
      destination_amount_label: t("shared.exchange_rate_tabs.destination_amount"),
      exchange_rate_label: t("shared.exchange_rate_tabs.exchange_rate"),
      convert_input: convert_input, destination_input: destination_input %>
<% if transferring %>
  <%= form.number_field :source_fee_amount, label: t("transfers.form.outgoing_fee"), min: 0, step: "any" %>
  <%= form.number_field :destination_fee_amount, label: t("transfers.form.incoming_fee"), min: 0, step: "any" %>
<% end %>
