<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: t("bitpanda_items.title")) %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <%= render "bitpanda_items/form", bitpanda_item: @bitpanda_item %>
      </div>
    <% end %>
  <% end %>
<% end %>
