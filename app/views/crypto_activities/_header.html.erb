<%# locals: (entry:, row:) %>
<div id="<%= dom_id(entry, :header) %>" class="mb-4 space-y-1 pr-10 min-w-0">
  <h3 class="font-medium flex flex-wrap items-center gap-2 break-words">
    <span class="text-2xl text-primary privacy-sensitive"><%= crypto_native(row.quantity, row.symbol, signed: true) %></span>
    <% if entry.linked? %>
      <span class="text-secondary" title="<%= t("transactions.transaction.linked_with_provider", provider: entry.account.provider_name&.titleize) %>">
        <%= icon "refresh-ccw", size: "sm" %>
      </span>
    <% end %>
  </h3>
  <p class="text-sm text-secondary privacy-sensitive"><%= crypto_euro(row.euro_value, signed: true) %></p>
  <p class="text-sm text-secondary"><%= crypto_time_label(row) %></p>
</div>
