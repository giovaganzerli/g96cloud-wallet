<%# Wallet artwork: maskable variant uses 64px margins to preserve the circular illustration; exterior pixels stay transparent. %>
{
  "name": "<%= j product_name %>",
  "short_name": "<%= j product_name %>",
  "icons": [
    {
      "src": "/branding/wallet-8ad5b8fbb493-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/branding/wallet-8ad5b8fbb493-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/branding/wallet-8ad5b8fbb493-maskable.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "shortcuts": [
    {
      "name": "<%= j t("transactions.quick_new.pwa_short_name") %>",
      "url": "/transactions/quick-new"
    }
  ],
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "scope": "/",
  "orientation": "any",
  "description": "<%= j product_name %> is your personal finance assistant.",
  "theme_color": "#F9F9F9",
  "background_color": "#F9F9F9"
}
