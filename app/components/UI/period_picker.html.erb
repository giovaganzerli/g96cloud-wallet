<%= render DS::Menu.new(variant: :button, placement: placement) do |menu| %>
  <% menu.with_button(
       type: "button",
       class: "inline-flex items-center gap-1.5 bg-container border border-secondary font-medium rounded-lg pl-3 pr-2 py-2 text-sm cursor-pointer text-primary hover:bg-container-inset-hover focus:outline-hidden focus:ring-0",
       aria: { label: t("UI.period_picker.aria_label", period: selected_label) }
     ) do %>
    <span class="whitespace-nowrap"><%= selected_label %></span>
    <%= helpers.icon("chevron-down", size: "sm") %>
  <% end %>

  <%# Both pickers navigate a Turbo frame — the dashboard's `dashboard_sections`
      and, implicitly, the account page's own container frame — and a frame
      navigation leaves the address bar alone. Without an explicit visit action
      a stale ?start_date/&end_date from a chart drag-select would outlive a
      preset pick and come back on refresh. See `turbo_action_for` for why the
      checked row replaces rather than advances. %>
  <% items.each do |key, label| %>
    <% item_selected = selected?(key) %>
    <% menu.with_item(
         variant: :link,
         text: label,
         href: href_for(key),
         frame: frame,
         selected: item_selected,
         data: { turbo_action: turbo_action_for(item_selected) }
       ) %>
  <% end %>

  <% if custom_row? %>
    <%# Always offered: it opens the dialog that picks the two dates. When a
        custom range is already active the same row carries it and is the
        checked one, so the list still shows exactly one selection and the way
        out of a custom range stays visible. %>
    <% menu.with_item(
         variant: :link,
         text: custom_selected? ? selected.label_short : t("UI.period_picker.custom"),
         href: custom_range_href,
         frame: :modal,
         selected: custom_selected?,
         data: { custom_range: true }
       ) %>
  <% end %>
<% end %>
